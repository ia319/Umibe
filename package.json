{
  "name": "umibe-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "lint": "node scripts/check-files.mjs lint",
    "format": "node scripts/check-files.mjs format",
    "format:check": "node scripts/check-files.mjs format:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
