{
  "name": "@umibe/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#internal/*": {
      "umibe-source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js"
    },
    "./storage-adapter": {
      "types": "./dist/storage/adapter.d.ts",
      "import": "./dist/storage/adapter.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
